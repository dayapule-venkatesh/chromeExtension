# Server
PORT=3000
HOST=127.0.0.1

# Required: get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini models. Switch only to models supported by your account and region.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Safety / limits
MAX_PROMPT_LENGTH=4000
IMAGE_MAX_PROMPT_LENGTH=1000
# Shared Gemini time budget in milliseconds, across retries.
REQUEST_TIMEOUT_MS=50000
GEMINI_MAX_ATTEMPTS=2

# Local per-IP rate limiting
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=30000
RATE_LIMIT_IMAGE_MAX=6

# Optional comma-separated extra origins allowed by CORS, e.g.
# ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=
